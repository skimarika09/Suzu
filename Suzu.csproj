<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Suzu</AssemblyName>
    <RootNamespace>Suzu</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>铃波</Product>
    <AssemblyTitle>铃波</AssemblyTitle>
    <Description>Windows 托盘 WiFi 自动切换工具：主用恢复自动切回、分级判定、有线暂停、终极降级。</Description>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 托盘图标与 exe 图标使用同一份 ico，保证三处显示一致 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Suzu.Assets.app.ico" />
  </ItemGroup>

  <!-- tools/ 下的辅助工程（文档截图 harness）不参与主程序编译 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- 单文件发布：dotnet publish -c Release -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 压缩只对 self-contained 单文件有效（NETSDK1176） -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

</Project>
